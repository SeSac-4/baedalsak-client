# API 기본 경로 (없으면 /api/v1)
VITE_API_BASE_URL=/api/v1

# 개발 서버가 /api 요청을 넘길 gateway 주소 (없으면 http://localhost:8080)
VITE_API_PROXY_TARGET=http://localhost:8080

# 토스페이먼츠 결제위젯 연동 클라이언트 키 (테스트 환경, 토스 문서용 테스트 키)
# 시크릿 키는 payment 서버에만 두고, 클라이언트 키와 같은 세트를 써야 한다
VITE_TOSS_CLIENT_KEY=test_gck_docs_Ovk5rk1EwkEbP0W43n07xlzm

# 카카오맵 JavaScript 키 (지도 표시 · 주소 → 좌표 변환). 실제 값은 .env 에만 넣는다 (팀 메신저 참고)
# 브라우저에 노출되는 키라 카카오 개발자 콘솔에 등록한 도메인(http://localhost:5173 등)에서만 동작한다
VITE_KAKAO_MAP_KEY=your_kakao_javascript_key
